{
  "name": "@gromlab/tasks-cli",
  "version": "0.1.0",
  "description": "Локальный CLI-трекер задач для AI-оркестраторов и агентов",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gromlab-ru/tasks-cli.git"
  },
  "homepage": "https://github.com/gromlab-ru/tasks-cli#readme",
  "bugs": {
    "url": "https://github.com/gromlab-ru/tasks-cli/issues"
  },
  "keywords": [
    "cli",
    "tasks",
    "ai-agents",
    "orchestration",
    "json"
  ],
  "type": "module",
  "bin": {
    "tasks-cli": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "package:check": "npm run build && node scripts/release/check-package.mjs",
    "release:check": "node scripts/release/check-tag.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/proper-lockfile": "^4.1.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
