{
  "name": "@gromlab/tasks-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Tasks CLI, API and web workspaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gromlab-ru/tasks-cli.git"
  },
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node --import ./apps/server/scripts/environment.mjs ./node_modules/turbo/bin/turbo run dev --filter=@tasks/server --filter=@tasks/web",
    "dev:app": "node --import ./apps/server/scripts/environment.mjs ./node_modules/turbo/bin/turbo run dev --filter=@tasks/server --filter=@tasks/web",
    "dev:server": "node --import ./apps/server/scripts/environment.mjs ./node_modules/turbo/bin/turbo run dev --filter=@tasks/server",
    "dev:web": "turbo run dev --filter=@tasks/web",
    "dev:ui": "npm run dev:web",
    "dev:cli": "node --conditions=tasks-source apps/cli/scripts/dev.mjs",
    "playground": "npm run --silent tasks --workspace=@tasks/playground --",
    "start": "node --import ./apps/server/scripts/environment.mjs ./node_modules/turbo/bin/turbo run start --filter=@tasks/server",
    "start:cli": "node apps/cli/dist/cli/main.js",
    "build": "turbo run build",
    "build:cli": "turbo run build --filter=@gromlab/tasks-cli",
    "build:server": "turbo run build --filter=@tasks/server",
    "build:web": "turbo run build --filter=@tasks/web",
    "build:core": "turbo run build --filter=@tasks/core",
    "build:contracts": "turbo run build --filter=@tasks/contracts",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@tasks/web",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "turbo run typecheck --filter=@tasks/web",
    "test": "turbo run test",
    "test:cli": "turbo run test --filter=@gromlab/tasks-cli",
    "test:server": "turbo run test --filter=@tasks/server --filter=@tasks/server-runtime",
    "test:core": "turbo run test --filter=@tasks/core",
    "test:contracts": "turbo run test --filter=@tasks/contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && turbo run lint typecheck test",
    "clean": "turbo run clean",
    "package:check": "npm run clean && turbo run package:check --filter=@gromlab/tasks-cli",
    "release:check": "npm run release:check --workspace=@gromlab/tasks-cli",
    "release:publish": "npm run release:publish --workspace=@gromlab/tasks-cli"
  },
  "devDependencies": {
    "agent-browser": "0.37.1",
    "prettier": "^3.6.2",
    "turbo": "2.10.12"
  },
  "prettier": {
    "trailingComma": "all",
    "printWidth": 100
  }
}
