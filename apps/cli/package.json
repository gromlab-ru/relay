{
  "name": "@gromlab/relay-cli",
  "version": "0.4.0",
  "description": "Локальная JSON-база для оркестрации задач между AI-агентами на одном хосте: CLI, API и веб-доска",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gromlab-ru/relay.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/gromlab-ru/relay#readme",
  "bugs": {
    "url": "https://github.com/gromlab-ru/relay/issues"
  },
  "keywords": [
    "cli",
    "tasks",
    "kanban",
    "rest-api",
    "ai-agents",
    "orchestration",
    "json"
  ],
  "type": "module",
  "imports": {
    "#manifest": "./package.json"
  },
  "bin": {
    "relay-cli": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "node --conditions=tasks-source scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "package:check": "node ../../scripts/package.mjs cli",
    "release:check": "node ../../scripts/release/relay.mjs check cli",
    "release:publish": "node ../../scripts/release/relay.mjs publish cli",
    "prepack": "node -e \"throw new Error('Выполните pnpm run package:check из корня репозитория; публикуйте только проверенный архив.')\""
  },
  "dependencies": {
    "@tasks/core": "workspace:*",
    "@tasks/project-runtime": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tasks/server-runtime": "workspace:*",
    "@tasks/contracts": "workspace:*",
    "@tasks/typescript-config": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
