{
  "name": "@tasks/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "create": "pnpm dlx @gromlab/create@0.2.0 --skip-update",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', '.cache']) rmSync(path, { recursive: true, force: true });\"",
    "dev": "pnpm --filter @tasks/rest-sdk run build && vite --host 127.0.0.1",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "browser": "agent-browser --config ./agent-browser.json",
    "browser:install": "agent-browser install",
    "generate:api": "pnpm --filter @tasks/rest-sdk run generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/core": "^9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@tasks/rest-sdk": "workspace:*",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "postcss-custom-media": "^12.0.1",
    "postcss-nesting": "^14.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
