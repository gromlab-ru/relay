{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "apps/cli/src/**/*.ts",
    "apps/server/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/*/test/**/*.mjs",
    "packages/*/test/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
