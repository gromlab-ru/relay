{
  "version": 1,
  "storageDir": ".tasks",
  "defaultStatus": "todo",
  "readyStatuses": [
    "todo"
  ],
  "statuses": {
    "todo": {
      "terminal": false,
      "satisfiesDependencies": false,
      "color": "cyan"
    },
    "in_progress": {
      "terminal": false,
      "satisfiesDependencies": false,
      "color": "yellow"
    },
    "review": {
      "terminal": false,
      "satisfiesDependencies": false,
      "color": "blue"
    },
    "done": {
      "terminal": true,
      "satisfiesDependencies": true,
      "color": "green"
    },
    "cancelled": {
      "terminal": true,
      "satisfiesDependencies": false,
      "color": "gray"
    }
  },
  "output": {
    "format": "text",
    "defaultLimit": 20,
    "maxBytes": 16384
  }
}
