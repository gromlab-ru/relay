{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@tasks/server#build": {
      "dependsOn": ["^build", "@tasks/web#build"],
      "outputs": ["dist/**"]
    },
    "@gromlab/tasks-cli#build": {
      "dependsOn": ["^build", "@tasks/web#build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "TASKS_CONFIG",
        "TASKS_ACTOR",
        "TASKS_PORT",
        "TASKS_API_URL",
        "TASKS_WEB_PORT"
      ]
    },
    "@gromlab/tasks-cli#dev": {
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["TASKS_ACTOR", "NO_COLOR", "FORCE_COLOR", "TERM"]
    },
    "start": {
      "dependsOn": ["build", "@tasks/web#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TASKS_CONFIG", "TASKS_ACTOR", "TASKS_PORT", "TASKS_WEB_PORT"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@gromlab/tasks-cli#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/skills/tasks-cli/**",
        "$TURBO_ROOT$/scripts/release/**"
      ],
      "outputs": []
    },
    "@tasks/core#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/server-runtime/src/**",
        "$TURBO_ROOT$/packages/project-runtime/src/**",
        "$TURBO_ROOT$/apps/mcp/src/**"
      ],
      "outputs": []
    },
    "@gromlab/tasks-mcp#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/release/**"],
      "outputs": []
    },
    "@gromlab/tasks-mcp#start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TASKS_CONFIG", "TASKS_MCP_PORT"]
    },
    "@tasks/server#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/apps/cli/package.json",
        "$TURBO_ROOT$/apps/cli/scripts/clean.mjs",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/packages/rest-sdk/**"
      ],
      "outputs": []
    },
    "package:check": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "npm_execpath",
        "npm_config_*",
        "NPM_CONFIG_*",
        "NODE_EXTRA_CA_CERTS",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "RELEASE_TAG"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
