{
  "openapi": "3.0.3",
  "info": {
    "title": "Backend API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/identity/authentication/sign-in": {
      "post": {
        "operationId": "signIn",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Сессия создана",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/identity/authentication/session": {
      "get": {
        "operationId": "getCurrentSession",
        "tags": ["Authentication"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Текущая сессия",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSessionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/identity/authentication/sign-out": {
      "post": {
        "operationId": "signOut",
        "tags": ["Authentication"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Сессия завершена"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/identity/users/current": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Профиль текущего пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Авторизация отсутствует или отклонена",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BackendApiProblem"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Сервис временно недоступен",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BackendApiProblem"
            }
          }
        }
      }
    },
    "schemas": {
      "SignInRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["login", "password"],
        "properties": {
          "login": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "SignInResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accessToken", "currentSession"],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "currentSession": {
            "$ref": "#/components/schemas/CurrentSessionResponse"
          }
        }
      },
      "CurrentSessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId", "permissions"],
        "properties": {
          "userId": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "email"],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "BackendApiProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_CREDENTIALS",
              "NOT_AUTHENTICATED",
              "TEMPORARILY_UNAVAILABLE"
            ]
          }
        }
      }
    }
  }
}
