{
  "name": "react-reference-demo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "create": "npx --yes @gromlab/create@0.2.0 --skip-update",
    "sprites": "npx --yes @gromlab/svg-sprites@2.1.0 src/infra/app-icons/svg-sprite.config.json",
    "predev": "npm run sprites",
    "dev": "vite",
    "generate:backend-api": "npx --yes @gromlab/rest-api-codegen@5.2.4 --input ./openapi/backend-api.openapi.json --output ./src/infra/backend-api/generated",
    "pretypecheck": "npm run sprites",
    "typecheck": "tsc -b",
    "prebuild": "npm run sprites",
    "build": "tsc -b && vite build",
    "check": "npm run build",
    "preview": "vite preview"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@tabler/icons-react": "^3.46.0",
    "clsx": "^2.1.1",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "swr": "^2.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "postcss-custom-media": "^12.0.1",
    "postcss-nesting": "^14.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
